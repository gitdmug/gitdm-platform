# GITDM production application
NEXT_PUBLIC_APP_URL=https://globalinstituteoftrading.com

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=

# Neon PostgreSQL
DATABASE_URL=postgresql://...

# Neon Managed Auth
NEON_AUTH_BASE_URL=https://...neonauth.../neondb/auth
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage / S3-compatible
NEON_STORAGE_BUCKET=gitdm-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Resend email
RESEND_API_KEY=
EMAIL_FROM=support@globalinstituteoftrading.com
EMAIL_FROM_NAME=Global Institute of Trading and Derivatives Markets
EMAIL_SUPPORT=support@globalinstituteoftrading.com
EMAIL_ADMISSIONS=admissions@globalinstituteoftrading.com
EMAIL_PRINCIPAL=principal@globalinstituteoftrading.com

# Institutional role bootstrap (optional)
PRINCIPAL_BOOTSTRAP_EMAIL=
GITDM_STAFF_ROLE_EMAILS=

# Pesapal payments
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=LIVE
PESAPAL_BASE=https://pay.pesapal.com/v3
PESAPAL_IPN_ID=
IPN_LISTENER_URL=https://globalinstituteoftrading.com/api/pesapal/ipn

# Google Workspace / Meet + Calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_IMPERSONATE_EMAIL=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIME_ZONE=Africa/Kampala

# --- AI cascade (Assistant + Market Insights) ---
# Tried in order until one succeeds.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Market data ---
# BiQuote is primary (no key). Optional fallbacks:
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
GITDM_WATCHLIST=EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,USD/CAD,NZD/USD,XAU/USD,BTC/USD,SPX

# Optional departmental inbox routing
EMAIL_ACADEMIC=
EMAIL_FINANCE=
EMAIL_PARTNERSHIPS=
