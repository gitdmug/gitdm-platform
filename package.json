{
  "name": "gitdm-platform",
  "version": "2.9.0-nav-auth-link",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "vercel-build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && npm run db:seed",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:sync-academics": "prisma db push && npm run db:seed",
    "db:sync-courses": "tsx scripts/sync-course-catalogue.ts",
    "db:sync-books": "tsx scripts/sync-book-catalogue.ts",
    "db:sync-organisation": "tsx scripts/sync-institutional-roles.ts",
    "db:sync-intake-timetable": "tsx scripts/sync-intake-timetable.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "16.4.7",
    "next": "16.3.6",
    "pg": "8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.1.5",
    "@neondatabase/auth": "0.5.0-beta",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-presigned-post": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.39.0",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "@neon/config": "1.8.3"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
