  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  user       User @relation(fields: [userId], references: [id])
}

model Announcement {
  id          String @id @default(cuid())
  title       String
  body        String
  audience    String? @default("ALL") // ALL | STUDENTS | STAFF | PUBLIC
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  @@index([publishedAt])
}

model EmailDelivery {
  id          String   @id @default(cuid())
  userId      String?
  recipient   String
  subject     String
  event       String?
  status      String
  provider    String   @default("RESEND")
  providerId  String?
  error       String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model Partner {
  id          String @id @default(cuid())
  name        String
  type        PartnerType
  status      PartnerStatus @default(DRAFT)
  logoUrl     String?
  websiteUrl  String?
  description String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User? @relation("PartnerCreator", fields: [createdById], references: [id])
  updatedBy   User? @relation("PartnerUpdater", fields: [updatedById], references: [id])
}

model SupportTicket {
  id           String @id @default(cuid())
  requesterId  String
  assigneeId   String?
  subject      String
  description  String
  category     String @default("GENERAL")
  status       SupportStatus @default(OPEN)
  priority     String @default("NORMAL")
  staffReply   String?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  requester    User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee     User? @relation("Assignee", fields: [assigneeId], references: [id])
  @@index([status, category])
  @@index([requesterId, createdAt])
}

model Group {
  id          String @id @default(cuid())
  name        String
  description String?
  status      GroupStatus @default(ACTIVE)
  memberships GroupMembership[]
}

model GroupMembership {
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([groupId, userId])
}

model ForumThread {
  id        String @id @default(cuid())
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     ForumPost[]
}

model ForumPost {
  id        String @id @default(cuid())
  threadId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LibraryResource {
  id          String @id @default(cuid())
  title       String
  author      String?
  type        LibraryResourceType
  description String?
  url         String?
  available   Boolean @default(true)
  accessScope String @default("CAMPUS") // PUBLIC | CAMPUS | ENROLLED
  programmeId String?
  createdAt   DateTime @default(now())
  loans       LibraryLoan[]
  @@index([available, accessScope])
}

model LibraryLoan {
  id         String @id @default(cuid())
  resourceId String
  userId     String
  borrowedAt DateTime @default(now())
  dueAt      DateTime?
  returnedAt DateTime?
  resource   LibraryResource @relation(fields: [resourceId], references: [id])
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  severity    AuditSeverity @default(INFO)
  metadataJson String?
  createdAt   DateTime @default(now())
  user        User? @relation(fields: [userId], references: [id])
  @@index([entity, entityId])
  @@index([userId, createdAt])
}


/// Privacy-conscious public reading counters: one unique browser token per book.
model BookReadEvent {
  id         String   @id @default(cuid())
  bookSlug   String
  visitorKey String
  createdAt  DateTime @default(now())
  @@unique([bookSlug, visitorKey])
  @@index([bookSlug, createdAt])
}

/// Persistent market analysis runs for institutional performance tracking.
/// Additive only — does not alter existing user or academic records.
model MarketAnalysisRun {
  id            String   @id @default(cuid())
  userId        String?
  symbol        String
  bias          String?
  buyPercent    Int      @default(50)
  sellPercent   Int      @default(50)
  timeframe     String?
  summary       String?
  analysisText  String?
  provider      String?  // openai | gemini | groq | together | openrouter | data-derived
  outcome       String?  // WIN | LOSS | NEUTRAL | PENDING
  outcomeNote   String?
  outcomeAt     DateTime?
  entryPrice    Float?
  stopLoss      Float?
  takeProfit    Float?
  resolvedAt    DateTime?
  retrievedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([symbol, createdAt])
  @@index([outcome, createdAt])
}

/// Cached or curated economic calendar events for educational analysis.
model EconomicCalendarEvent {
  id          String   @id @default(cuid())
  title       String
  country     String?
  currency    String?
  impact      String?  // HIGH | MEDIUM | LOW
  scheduledAt DateTime
  actual      String?
  forecast    String?
  previous    String?
  source      String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([scheduledAt])
  @@index([impact, scheduledAt])
}
