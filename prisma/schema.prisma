generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

enum RoleCode {
  PRINCIPAL
  ACADEMIC_DIRECTOR
  REGISTRAR
  FACULTY
  LECTURER
  ADMISSIONS
  FINANCE
  EXAM_OFFICER
  STUDENT_AFFAIRS
  LIBRARY
  IT
  MARKETING
  PARTNER_SUPPORT
  ADMISSIONS_DIRECTOR
  ADMISSIONS_COUNSELOR
  ONBOARDING_TECH_SUPPORT
  CURRICULUM_DEVELOPER
  ONLINE_INSTRUCTOR
  DIFFERENTIATED_LEARNING_COORDINATOR
  STUDENT_SUCCESS_COACH
  ACADEMIC_ADVISOR_REGISTRAR
  SCHOOL_COUNSELOR
  CTO_IT_DIRECTOR
  LMS_ADMINISTRATOR
  HELPDESK_TECHNICIAN
  OPERATIONS_COMPLIANCE_MANAGER
  BURSAR_BILLING_SPECIALIST
  PARENT_GUARDIAN
  ALUMNI
  STUDENT
}

enum ProgrammeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AcademicPeriodStatus {
  PLANNED
  OPEN
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  FEE_PENDING
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_REQUIRED
  ADDITIONAL_INFORMATION
  ADMITTED
  ACCEPTED
  REJECTED
  DEFERRED
  APPEAL_PENDING
  WITHDRAWN
}

enum ApplicationAppealStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

enum InvoiceKind {
  APPLICATION_FEE
  TUITION
  OTHER
}

enum DocumentType {
  IDENTITY
  PASSPORT
  DRIVERS_LICENCE
  VOTER_SLIP
  EDUCATION_CERTIFICATE
  PASSPORT_PHOTO
  EDUCATION
  OTHER
}

enum AdmissionDecisionType {
  ACCEPTED
  REJECTED
  CONDITIONAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewMode {
  PHYSICAL
  ONLINE
}

enum InterviewOutcome {
  CONTINUE
  REJECT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  SUSPENDED
  WITHDRAWN
  REPEATING
}

enum AccessLevel {
  LIMITED
  FULL
  RESTRICTED
}

enum ModuleApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum LessonType {
  VIDEO
  ARTICLE
  DOCUMENT
  LIVE_SESSION
  EXTERNAL
  RESOURCE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum AssessmentStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  PUBLISHED
  CLOSED
}

enum ExamDeliveryMode {
  ONLINE
  ONSITE
  HYBRID
}

enum ExamSubmissionMode {
  ONLINE_FORM
  FILE_UPLOAD
  ONLINE_AND_FILE
}

enum ExamDocumentType {
  QUESTION_PAPER
  ANSWER_TEMPLATE
  INSTRUCTIONS
  REFERENCE
}

enum TutorialStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum ClassDeliveryMode {
  ONLINE
  ONSITE
  HYBRID
}

enum StudentRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum StudentRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
  RESULTS_PUBLISHED
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreProductStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum StoreAudience {
  STUDENT
  PUBLIC
}

enum StoreOrderStatus {
  PENDING
  CONFIRMED
  READY
  COLLECTED
  CANCELLED
}

enum StoreFulfillmentMode {
  DIGITAL
  HARD_COPY
  BOTH
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ExamQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERICAL
  ESSAY
  LINK_RESPONSE
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_MARKED
  MANUAL_REVIEW
  MARKED_PENDING_CONFIRMATION
  FINALIZED
  ABANDONED
}

enum GradeStatus {
  PROVISIONAL
  FINAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CertificateStatus {
  ELIGIBLE
  ISSUED
  REVOKED
}

enum StaffClaimStatus {
  DRAFT
  SUBMITTED
  DEPARTMENT_REVIEW
  FINANCE_REVIEW
  APPROVED
  REJECTED
  DISBURSED
}

enum VendorInvoiceStatus {
  SUBMITTED
  FINANCE_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  EXCEPTION
  RESOLVED
}

enum StudentAidStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  AWARDED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CLOSED
}

enum PayrollStatus {
  ISSUED
  PAID
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PartnerType {
  INDUSTRY
  EDUCATION
  TECHNOLOGY
  COMMUNITY
  OTHER
}

enum PartnerStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum NotificationType {
  SYSTEM
  ACADEMIC
  FINANCE
  ADMISSIONS
  SUPPORT
  COMMUNITY
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum LibraryResourceType {
  BOOK
  ARTICLE
  VIDEO
  JOURNAL
  REPORT
  OTHER
}


model TradingFloorBooking {
  id            String   @id
  reference     String   @unique
  name          String
  email         String
  phone         String
  sessionDate   String
  qualification String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  @@index([sessionDate, status])
  @@index([email])
}

model User {
  id                 String        @id @default(cuid())
  authUserId         String        @unique
  email              String        @unique
  firstName          String?
  lastName           String?
  phone              String?
  termsAcceptedAt    DateTime?
  status             UserStatus    @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  profile            Profile?
  roles              UserRole[]
  departments        UserDepartment[]
  applications       Application[]
  parentLinks        ParentStudent[] @relation("Parent")
  studentLinks       ParentStudent[] @relation("Student")
  admissionDecisions AdmissionDecision[]
  interviews         Interview[] @relation("Interviewer")
  facultyCourses     CourseFaculty[]
  scheduledClasses   TimetableEvent[] @relation("ScheduledClasses")
  taughtClasses      TimetableEvent[] @relation("LecturerClasses")
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  submissions        AssignmentSubmission[]
  assignmentsCreated Assignment[] @relation("AssignmentCreator")
  gradedSubmissions  AssignmentSubmission[] @relation("Grader")
  quizAttempts       QuizAttempt[]
  examAttempts       ExamAttempt[]
  examsCreated       Exam[] @relation("ExamCreator")
  examsSubmitted     Exam[] @relation("ExamSubmitter")
  examsApproved      Exam[] @relation("ExamApprover")
  grades             Grade[]
  attendance         AttendanceRecord[]
  classAttendance    ClassAttendanceRecord[]
  certificates       Certificate[]
  transcripts         Transcript[]
  payments           Payment[]
  receipts           Receipt[]
  notifications      Notification[]
  supportTickets     SupportTicket[] @relation("Requester")
  assignedTickets    SupportTicket[] @relation("Assignee")
  groupMemberships   GroupMembership[]
  forumThreads       ForumThread[]
  forumPosts         ForumPost[]
  libraryLoans       LibraryLoan[]
  auditLogs          AuditLog[]
  roleAssignmentsMade StaffRoleAssignment[] @relation("RoleAssignmentsMade")
  pendingRoleAssignments StaffRoleAssignment[]
  expenseClaims      StaffExpenseClaim[] @relation("ClaimRequester")
  departmentClaims   StaffExpenseClaim[] @relation("ClaimDepartmentReviewer")
  financeClaims      StaffExpenseClaim[] @relation("ClaimFinanceReviewer")
  vendorInvoices     VendorInvoice[] @relation("VendorCreator")
  studentAidApplications StudentAidApplication[]
  importedBankTransactions BankTransaction[] @relation("BankTransactionImporter")
  approvedBudgets FinanceBudget[] @relation("BudgetApprover")
  financialOverrides Enrollment[] @relation("FinancialOverride")
  payrollRecords PayrollRecord[] @relation("PayrollStaff")
  createdPartners    Partner[] @relation("PartnerCreator")
  updatedPartners    Partner[] @relation("PartnerUpdater")
  timetableEvents    TimetableEvent[] @relation("TimetableStudent")
  studentRequests    StudentRequest[]
  requestMessages    StudentRequestMessage[]
  storeOrders        StoreOrder[]
  storeCarts         StoreCart[]
  storePayments      StorePayment[]
  staffInvitationsCreated StaffInvitation[] @relation("StaffInvitationCreator")
  electionCandidates ElectionCandidate[]
  electionVotes      ElectionVote[]
  fileAssets         FileAsset[]
  emailDeliveries EmailDelivery[]
  admissionsCommunicationsSent AdmissionsCommunication[] @relation("AdmissionsCommunicationSender")
  admissionsCommunicationsReceived AdmissionsCommunication[] @relation("AdmissionsCommunicationRecipient")
  marketAnalysisRuns MarketAnalysisRun[]
}


model FileAsset {
  id           String   @id @default(cuid())
  ownerUserId  String?
  originalName String
  mimeType     String
  size         Int
  purpose      String?
  storageKey   String   @unique
  createdAt    DateTime @default(now())
  owner        User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  @@index([ownerUserId, createdAt])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  dateOfBirth    DateTime?
  gender         String?
  nationality    String?
  address        String?
  city           String?
  country        String?
  emergencyName  String?
  emergencyPhone String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserDepartment[]
  expenseClaims StaffExpenseClaim[]
  vendorInvoices VendorInvoice[]
  budgets FinanceBudget[]
  staffInvitations StaffInvitation[]
  storeProducts StoreProduct[]
  timetableEvents TimetableEvent[]
  roles       Role[]
  actingAssignments StaffRoleAssignment[] @relation("ActingDepartment")
}

model UserDepartment {
  userId       String
  departmentId String
  isHead       Boolean @default(false)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@id([userId, departmentId])
}

model Role {
  id           String       @id @default(cuid())
  code         RoleCode     @unique
  name         String
  description  String?
  isActive     Boolean      @default(true)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users        UserRole[]
  permissions  RolePermission[]
  actingAssignments StaffRoleAssignment[] @relation("ActingRole")
  @@index([departmentId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  permissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}


enum StaffRoleAssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model StaffRoleAssignment {
  id           String                     @id @default(cuid())
  userId       String
  roleId       String
  departmentId String
  assignedById String
  status       StaffRoleAssignmentStatus @default(PENDING)
  createdAt    DateTime                   @default(now())
  acceptedAt   DateTime?
  expiresAt    DateTime?
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role                       @relation("ActingRole", fields: [roleId], references: [id], onDelete: Cascade)
  department   Department                 @relation("ActingDepartment", fields: [departmentId], references: [id], onDelete: Cascade)
  assignedBy   User                       @relation("RoleAssignmentsMade", fields: [assignedById], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@index([departmentId, status])
}

model ParentStudent {
  parentId   String
  studentId  String
  relationship String?
  isPrimary  Boolean @default(false)
  parent     User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  student    User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)
  @@id([parentId, studentId])
}


model Faculty {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Programme {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  shortName             String?
  description           String?
  durationMonths        Int
  status                ProgrammeStatus @default(DRAFT)
  applicationFee        Decimal  @db.Decimal(12,2) @default(0)
  tuitionFee            Decimal  @db.Decimal(12,2) @default(0)
  currency              String   @default("UGX")
  requiresApplication   Boolean  @default(true)
  requiresAdmission     Boolean  @default(true)
  applicationsOpen      Boolean  @default(true)
  nextStartDate         DateTime?
  intakeLabel           String?
  awardTitle            String?
  deliveryMode          String?  @default("ONLINE")
  entryRequirements     String?
  learningOutcomes      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  periods               AcademicPeriod[]
  rules                 ProgrammeRule?
  courses               Course[]
  applications          Application[]
  enrollments           Enrollment[]
  certificates          Certificate[]
  transcripts            Transcript[]
}

model ProgrammeRule {
  id                         String   @id @default(cuid())
  programmeId                String   @unique
  minimumEducation           String   @default("Secondary education / Uganda S4 equivalent")
  passMarkPercent            Decimal  @db.Decimal(5,2) @default(50)
  attendanceMinimumPercent   Decimal  @db.Decimal(5,2) @default(70)
  assignmentWeightPercent    Decimal  @db.Decimal(5,2) @default(30)
  quizWeightPercent          Decimal  @db.Decimal(5,2) @default(20)
  examWeightPercent          Decimal  @db.Decimal(5,2) @default(50)
  examAttemptsAllowed        Int      @default(3)
  activationPaymentPercent   Decimal  @db.Decimal(5,2) @default(60)
  examPaymentClearancePercent Decimal  @db.Decimal(5,2) @default(100)
  allowsCourseRepeat         Boolean  @default(true)
  academicTeamDecidesResit   Boolean  @default(true)
  certificateMaxMonths       Int      @default(2)
  requiresIdentityDocument   Boolean  @default(true)
  requiresEducationDocument  Boolean  @default(true)
  interviewByAdmissions     Boolean  @default(true)
  programme                  Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
}

model AcademicPeriod {
  id             String @id @default(cuid())
  programmeId    String
  name           String
  sequence       Int
  startsAt       DateTime?
  endsAt         DateTime?
  feeAmount      Decimal @db.Decimal(12,2)
  currency       String @default("UGX")
  status         AcademicPeriodStatus @default(PLANNED)
  programme      Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  courseLinks    PeriodCourse[]
  invoices       Invoice[]
  exams          Exam[]
  grades         Grade[]
  attendance    AttendanceRecord[]
  classAttendance ClassAttendanceRecord[]
  timetableEvents TimetableEvent[]
  tutorials     Tutorial[]
  transcriptEntries TranscriptEntry[]
  @@unique([programmeId, sequence])
}

model Course {
  id          String @id @default(cuid())
  programmeId String?
  facultyId   String?
  code        String
  title       String
  description String?
  orderIndex  Int @default(0)
  durationMonths Int @default(1)
  sessionsPerWeek Int @default(2)
  catalogueVisible Boolean @default(true)
  publicImageUrl String?
  published   Boolean @default(false)
  studentSelectable Boolean @default(true)
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  facultyUnit Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  faculty     CourseFaculty[]
  periodLinks PeriodCourse[]
  enrollments CourseEnrollment[]
  assignments Assignment[]
  quizzes     Quiz[]
  exams       Exam[]
  timetableEvents TimetableEvent[]
  tutorials Tutorial[]
  grades      Grade[]
  transcriptEntries TranscriptEntry[]
  attendance  AttendanceRecord[]
  classAttendance ClassAttendanceRecord[]
  @@unique([code])
  @@index([facultyId, published])
  @@index([programmeId, orderIndex])
}

model PeriodCourse {
  periodId String
  courseId String
  required Boolean @default(true)
  period   AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([periodId, courseId])
}

model CourseFaculty {
  courseId String
  userId   String
  isLead   Boolean @default(false)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([courseId, userId])
}

model CourseModule {
  id         String @id @default(cuid())
  courseId   String
  title      String
  description String?
  orderIndex Int @default(0)
  published  Boolean @default(false)
  approvalStatus ModuleApprovalStatus @default(APPROVED)
  deliveryStartAt DateTime?
  deliveryEndAt DateTime?
  deliveryDurationMinutes Int?
  studyDaysJson String?
  submittedAt DateTime?
  submittedById String?
  approvedAt DateTime?
  approvedById String?
  rejectionReason String?
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons    Lesson[]
  timetableEvents TimetableEvent[]
  @@index([courseId, orderIndex])
}

model Lesson {
  id         String @id @default(cuid())
  moduleId   String
  title      String
  type       LessonType
  content    String?
  videoUrl   String?
  durationMinutes Int?
  orderIndex Int @default(0)
  required   Boolean @default(true)
  published  Boolean @default(false)
  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources  LearningResource[]
  progress   LessonProgress[]
  @@index([moduleId, orderIndex])
}

model LearningResource {
  id       String @id @default(cuid())
  lessonId String
  title    String
  url      String
  fileType String?
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String @id @default(cuid())
  userId      String
  programmeId String
  periodId    String?
  studentNumber String? @unique
  status      EnrollmentStatus @default(PENDING)
  accessLevel AccessLevel @default(LIMITED)
  admittedAt  DateTime?
  activatedAt DateTime?
  completedAt DateTime?
  financialClearanceOverride Boolean @default(false)
  financialOverrideReason String?
  financialOverrideById String?
  financialOverrideAt DateTime?
  financialOverrideBy User? @relation("FinancialOverride", fields: [financialOverrideById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme   Programme @relation(fields: [programmeId], references: [id])
  period      AcademicPeriod? @relation(fields: [periodId], references: [id])
  courses     CourseEnrollment[]
  invoices    Invoice[]
  @@index([userId, status])
}

model CourseEnrollment {
  id           String @id @default(cuid())
  enrollmentId String
  courseId     String
  status       EnrollmentStatus @default(ACTIVE)
  attempt      Int @default(1)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course       Course @relation(fields: [courseId], references: [id])
  @@unique([enrollmentId, courseId, attempt])
}

model LessonProgress {
  id          String @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean @default(false)
  completedAt DateTime?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model Assignment {
  id          String @id @default(cuid())
  courseId    String
  title       String
  instructions String
  maxMarks    Decimal @db.Decimal(8,2)
  dueAt       DateTime?
  status      AssignmentStatus @default(DRAFT)
  createdById String?
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User? @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String @id @default(cuid())
  assignmentId String
  userId       String
  submittedAt  DateTime?
  fileUrl      String?
  textAnswer   String?
  status       SubmissionStatus @default(DRAFT)
  score        Decimal? @db.Decimal(8,2)
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy     User? @relation("Grader", fields: [gradedById], references: [id])
  files        AssignmentSubmissionFile[]
  @@unique([assignmentId, userId])
}

model AssignmentSubmissionFile {
  id             String @id @default(cuid())
  submissionId   String
  originalName   String
  url            String
  uploadedAt     DateTime @default(now())
  submission     AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Quiz {
  id              String @id @default(cuid())
  courseId        String
  title           String
  instructions    String?
  passMarkPercent Decimal @db.Decimal(5,2) @default(50)
  attemptsAllowed Int @default(1)
  timeLimitMinutes Int?
  status          AssessmentStatus @default(DRAFT)
  course          Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  attempts        QuizAttempt[]
}

model QuizQuestion {
  id          String @id @default(cuid())
  quizId      String
  prompt      String
  optionsJson String?
  correctJson String?
  marks       Decimal @db.Decimal(8,2) @default(1)
  orderIndex  Int @default(0)
  quiz        Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String @id @default(cuid())
  quizId      String
  userId      String
  attemptNo   Int
  status      AttemptStatus @default(NOT_STARTED)
  startedAt   DateTime?
  submittedAt DateTime?
  score       Decimal? @db.Decimal(8,2)
  quiz        Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]
  @@unique([quizId, userId, attemptNo])
